# Dependencies
node_modules/

# Build output — the console bundle is built by `npm run build:client`
dist/

# IBM Plex fonts staged into the client by scripts/copy-plex-fonts.js.
# Copied from node_modules at build time rather than committed.
client/public/plex/

# Environment — never commit real credentials
.env
.env.local
.env.*.local
# A CA cert holds no private key, so the committed one is safe in a public repo.
# Any extra cert you add stays untracked.
src/config/*.crt

# Logs
*.log
npm-debug.log*

# Temporary files created by reviewBundle.js
tmp/
temp/
*.tmp
/private/tmp/pr-reviews/

# Test / diagnostic artefacts written by scripts/
scripts/*.json

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Bob local state (settings, cached sessions) — not project files
.bob/cache/
.bob/sessions/
.bob/tmp/
.bob/artifacts/
.bob/.bob-errors/
