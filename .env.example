# Carbon Monitor console sign-in credentials (used when AUTH_REQUIRED=true below)
CONSOLE_USERNAME=carbon-monitor-admin
CONSOLE_PASSWORD=

# GitHub Configuration
GITHUB_AI_AGENT_TOKEN=ghp_your_github_token_here
GITHUB_AI_AGENT_OWNER=carbon-design-system
GITHUB_AI_AGENT_REPO=carbon
# GitHub Enterprise: set to your API base.
# GITHUB_API_BASE_URL=https://api.github.com
# Scratch repo for scripts/create-test-pr.js and create-oversized-test-pr.js.
# Never the repo being reviewed.
# TEST_PR_OWNER=
# TEST_PR_REPO=

# CLI Agent Configuration
# Which agent reviews: bob (IBM Bob through the Bob Shell CLI, the default) or
# claude (Claude through the Claude Code CLI). Each needs its key below.
GITHUB_AI_AGENT_CLI=bob

# Agent API Keys
#
# Bob authenticates by browser SSO on a laptop, which cannot complete in a
# container — BOB_API_KEY is the only viable path there. Create one with Scope
# set to "Inference" in the Bob web portal.
BOB_API_KEY=your_bob_api_key_here
#
# Only required when the API key is of type "general" rather than "Inference";
# leave blank otherwise, as sending it with an Inference key breaks the run.
#
# Must be a real team_id or blank, never a placeholder. Bob 2.0.5 checks
# --team-id against the key's teams and exits with "Invalid team ID" when
# none match. Bob 2.0.0 skipped that check, so BOB_TEAM_ID=default worked
# until the 2.0.5 bump (Oct 2026) and then failed every review. Blanking it
# here does not clear the Code Engine secret, because deploy_ce.sh skips
# empty keys. Remove it there with:
#   ibmcloud ce secret update --name carbon-monitor-secrets --rm BOB_TEAM_ID
BOB_TEAM_ID=
# Bob instance to bill against when the key spans more than one; blank otherwise.
# BOB_INSTANCE_ID=
#
# Claude (GITHUB_AI_AGENT_CLI=claude) runs through the Claude Code CLI in print
# mode and authenticates with an API key from the Claude Console
# (https://console.anthropic.com). Leave blank when the agent is bob.
# deploy_ce.sh stores it in the Code Engine secret beside BOB_API_KEY.
ANTHROPIC_API_KEY=

# Bob output format: stream-json (default) gives exact token and cost stats;
# pretty restores the legacy text path as a kill switch.
# BOB_OUTPUT_FORMAT=stream-json
# Per-review spend cap in Bobcoins; blank or 0 means no cap.
# BOB_MAX_COST=
# Per-review turn cap; blank or 0 means Bob's default (100).
# BOB_MAX_TURNS=
# Tool groups Bob may not use; blank disables none. Recommended for a read-only reviewer:
# BOB_DISABLE_TOOL_GROUPS=edit,execute,subagent,mode
# BOB_DISABLE_TOOL_GROUPS=

# Claude model and reasoning effort (the defaults).
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_EFFORT=high
# Per-review spend cap in USD; 0 disables. Spend can pass the cap slightly.
# CLAUDE_MAX_BUDGET_USD=5
# Per-review turn cap; 0 disables.
# CLAUDE_MAX_TURNS=60
# Tools Claude may use.
# CLAUDE_ALLOWED_TOOLS=Read(./**),Glob,Grep,Skill(carbon-builder),mcp__carbon-mcp
# Tools Claude may not use. Read(./claude-config/**), Read(~/**) and Read(//proc/**) are always added.
# CLAUDE_DISALLOWED_TOOLS=Bash,Edit,Write,MultiEdit,NotebookEdit,WebFetch,WebSearch,Agent
# Monthly budget in USD for scheduled reviews; blank means unmetered.
# CLAUDE_MONTHLY_BUDGET_USD=
# Scheduled reviews pause below this percentage of the monthly budget.
# CLAUDE_BUDGET_LOW_PCT=10

# Reviews in flight inside one batch; default 2, 1 restores sequential reviews.
# Each Bob process wants 4 GB (Bob's docs), so 2 pairs with MEMORY=8G in
# deploy_ce.sh. At the default 1 vCPU / 4 GB a large PR may OOM one review.
# Applies to bob and claude alike; each review runs in its own process with
# its own config directory.
# REVIEW_CONCURRENCY=2

# Where review bundles are created. Leave blank on macOS: the default is
# /private/tmp, which Bob treats as trusted (os.tmpdir() resolves to
# /var/folders/... which is NOT, and Bob silently disables MCP tools there).
# The container sets this to /workspace.
BOB_WORKSPACE_ROOT=

# Optional Configuration
# Target a specific PR number instead of auto-selecting (leave blank for auto)
# GITHUB_AI_AGENT_PR_NUMBER=
GITHUB_AI_AGENT_MAX_PRS=10
GITHUB_AI_AGENT_DAYS_BACK=21
# Size gate: a PR with more changed files than this is labelled, told so in a
# comment, and skipped.
# GITHUB_AI_AGENT_MAX_FILES=300
# Total input token budget for the agent (prompt overhead + diff).
# Derivation: 200k context − 40k MCP − 20k output = 140k input.
# Effective diff budget = (value − 12000 prompt overhead) × 4 chars/token = ~512k chars.
GITHUB_AI_AGENT_MAX_INPUT_TOKENS=140000
GITHUB_AI_AGENT_REVIEW_LABEL=AIReviewed
GITHUB_AI_AGENT_POST_INLINE_COMMENTS=true
GITHUB_AI_AGENT_POST_SUMMARY_COMMENT=true
GITHUB_AI_AGENT_KEEP_ARTIFACTS=false
# Test mode: keep findings the Carbon MCP could not verify instead of dropping them.
# GITHUB_AI_AGENT_SKIP_CARBON_FILTER=false

# ── API server / operator console ─────────────────────────────────────────────
#
# Port. Code Engine injects PORT and it takes precedence over API_PORT.
API_PORT=3000

# Bearer token for machine callers (CI, curl). Not used by the console, which
# signs in and uses a session cookie instead.
API_SECRET=your_secure_api_secret_here
API_ENABLE_AUTH=true
#
# Allowed origin for cross-origin calls; only a separate Vite dev server needs it.
# CORS_ORIGIN=*
#
# Proxies between the client and this process (default 1). The sign-in throttle
# keys on the X-Forwarded-For entry that many from the end. Too low and every
# user shares one proxy address, so five bad passwords lock everyone out; too
# high and a client can pick its own address. Check the first-failed-sign-in log
# line on the deployed instance.
# TRUSTED_PROXY_HOPS=1
#
# Lines kept in the in-memory run log the console streams.
# REVIEW_LOG_MAX_LINES=2000

# ── Console sign-in (feature flag) ────────────────────────────────────────────
#
# The code default is OFF (open console, no login page) when this is unset — a
# security posture is chosen, never inferred from NODE_ENV.
#
# Set to true to require a password-protected login. Accepts true/1/yes/on
# (and false/0/no/off); anything else is reported at startup and treated as off,
# so a typo cannot leave you believing the console is protected when it is not.
#
# With this ON, CONSOLE_USERNAME and CONSOLE_PASSWORD (above) are the sign-in
# credentials and must be set, and SESSION_SIGNING_KEY should be too.
AUTH_REQUIRED=true

# HMAC key for session cookies. Only used when AUTH_REQUIRED is on. Without it
# the server falls back to a per-process random key, so every restart signs all
# operators out.
#   openssl rand -hex 32
SESSION_SIGNING_KEY=
# How long a sign-in lasts, in seconds.
# SESSION_MAX_AGE_SECONDS=28800
# Shown on the sign-in page when access is denied; blank hides it.
# CONSOLE_CONTACT_EMAIL=

# The console's public URL. In Code Engine this is folded into the revision by
# deploy_ce.sh; locally it is derived from the request. It is the OAuth
# redirect_uri, so "Sign in with IBMid" fails if it points at the wrong host.
# BASE_URL=

# ── Carbon MCP connection ─────────────────────────────────────────────────────
#
# Endpoint. Override only to point at a non-production Carbon MCP.
# CARBON_MCP_URL=https://mcp.carbondesignsystem.com/mcp
#
# Where the rotating OAuth refresh token is persisted. Put this on durable
# storage in the cloud, or a restart forces an operator back through sign-in.
# MCP_STATE_PATH=
#
# With MCP_STATE_BACKEND=elasticsearch (the deploy_ce.sh default) the state lives
# in this dedicated index and document instead of the file above. Two
# deployments sharing one cluster need different index names.
# MCP_STATE_INDEX=carbon-monitor-mcp-state
# MCP_STATE_DOC_ID=connection
#
# Renew this many seconds before the token expires (Carbon MCP's own margin is
# 300s; wider leaves room to retry a failed attempt).
# MCP_REFRESH_MARGIN_SEC=900
#
# How often the background timer re-checks expiry.
# MCP_REFRESH_CHECK_MS=60000

# Health-check budget for `bob --version`. Bob is a ~20MB bundle and is slow to
# start on a cold container — raise this if the status panel reports Bob as
# not responding when it is in fact fine.
# BOB_CHECK_TIMEOUT_MS=20000

# ── Bobcoins accounting ───────────────────────────────────────────────────────
#
# All three take a plain number. A value that is not a positive number is
# rejected with a warning at first use and the default is applied — so
# "10s" or "1e3x" degrades loudly rather than silently disabling the feature.
#
# Bob gateway for the balance; change for a non-us-east instance.
# BOB_GATEWAY_BASE_URL=https://api.us-east.bob.ibm.com
#
# How long a fetched balance stays fresh. The console polls from every open tab,
# so this is what stops a handful of tabs hammering the Bob gateway.
# BOB_CREDITS_TTL_MS=60000
#
# Hard ceiling on one gateway call, headers AND body. Bounds how long a hung
# billing host can delay a review.
# BOB_CREDITS_TIMEOUT_MS=10000
#
# Percentage of the monthly budget below which the Bobcoins tile warns.
# BOB_CREDITS_LOW_PCT=10

# Newest per-review cost records kept in the local ledger; older ones are
# dropped on write. The whole file is read and parsed on each ledger query, so
# raising this trades memory and CPU per request for more history.
# CREDIT_LEDGER_MAX=1000
#
# Where the ledger lives. Defaults beside MCP_STATE_PATH (/workspace in the
# container), the one directory the deployment already treats as writable.
# CREDIT_LEDGER_PATH=

# ── Slack notifications ───────────────────────────────────────────────────────
#
# Post a digest to a Slack channel at the end of each scheduled review run.
# Manual runs triggered from the console do NOT post to Slack.
#
# Setup (takes ~2 minutes):
#   1. Go to https://api.slack.com/apps → Create New App → From scratch
#   2. Name it "Carbon Monitor", pick your workspace
#   3. Incoming Webhooks → toggle On → Add New Webhook to Workspace
#   4. Select your target channel (e.g. #carbon-monitor)
#   5. Copy the webhook URL and paste it below
#
# When SLACK_WEBHOOK_URL is blank Slack notifications are disabled — no error,
# no log noise. The webhook URL is a bearer credential: never commit it.
#
SLACK_WEBHOOK_URL=

# ── Scheduled reviews ─────────────────────────────────────────────────────────
#
# Where the schedule state file lives. Defaults beside MCP_STATE_PATH
# (/workspace in the container) — the same durable-storage mount used by the
# MCP refresh token and the credit ledger. On a fresh container the schedule
# defaults to disabled (enabled: false); the operator enables it from the
# Settings → Scheduled reviews panel in the console.
#
# If MCP_STATE_PATH is not set either, defaults to ~/.config/carbon-monitor/schedule.json.
# SCHEDULE_STATE_PATH=
#
# Zone of the daily run time (IANA name). The console converts for display.
# SCHEDULE_TIMEZONE=America/Chicago

# ── IBM Cloud deployment (deploy_ce.sh only) ─────────────────────────────
#
# Used ONLY by ./deploy_ce.sh, which sources this file. Not read by the app,
# and deliberately NOT copied into the Code Engine secret — it authenticates the
# deploy, and the running container has no use for a credential that can redeploy
# it.
#
# Create one with:
#   ibmcloud iam api-key-create carbon-monitor-deploy \
#     -d "Carbon Monitor CE deploy" --file /tmp/cm-key.json
# then copy the "apikey" value here and delete the file.
#IBMCLOUD_API_KEY=''

# Deployment target, read by deploy_ce.sh.
REGION=us-south
RESOURCE_GROUP=my-resource-group
PROJECT=my-code-engine-project
NAMESPACE=my-registry-namespace
# APP=carbon-monitor
# VERSION=1.4.0
#
# Name of the Code Engine secret. deploy_ce.sh creates or updates it from
# the credentials in THIS file on every deploy — there is no separate secret to
# maintain by hand.
# SECRET_NAME=carbon-monitor-secrets
#
# Registry secret for ICR pulls; deploy_ce.sh creates it if missing.
# REGISTRY_SECRET=icr-secret
#
# Keys deploy_ce.sh copies from this file into that secret, space separated.
# Another job lists its own credentials here. IBMCLOUD_API_KEY never belongs.
# SECRET_KEYS="GITHUB_AI_AGENT_TOKEN BOB_API_KEY BOB_TEAM_ID BOB_INSTANCE_ID ES_URL ES_USERNAME ES_PASSWORD ES_CA_CERT_PATH CONSOLE_USERNAME CONSOLE_PASSWORD SESSION_SIGNING_KEY API_SECRET SLACK_WEBHOOK_URL"
#
# Also overridable: LOG_LEVEL, MCP_STATE_BACKEND (elasticsearch|file), CPU, MEMORY,
# MIN_SCALE, MAX_SCALE, CONCURRENCY, REQUEST_TIMEOUT, SCALE_DOWN_DELAY, IMAGE_NAME.

# ── Metrics / Observability ───────────────────────────────────────────────────
#
# Elasticsearch — leave ES_URL blank to disable ES; console-only logging still
# works.
#
# NOTE: these are Elasticsearch credentials ONLY. Console sign-in has its own
# CONSOLE_USERNAME / CONSOLE_PASSWORD (near the top), so ES_USERNAME / ES_PASSWORD
# are never a login and can be left blank when ES_URL is blank.
#
ES_URL=
ES_USERNAME=
ES_PASSWORD=
ES_CA_CERT_PATH=
# Kibana used by the scripts in kibana/README.md.
# KIBANA_URL=http://localhost:5601
# Event retention in days (min 90); used by scripts/init-index.js.
# EVENTS_RETENTION_DAYS=180
#
# How to get these values:
#   ES_URL      — IBM Elasticsearch cluster endpoint, e.g. https://cluster.es.ibm.com:9243
#   ES_USERNAME — usually "elastic" or a service-account username
#   ES_PASSWORD — from the cluster's service credentials
#   ES_CA_CERT_PATH — PEM CA cert path. IBM Cloud Databases for Elasticsearch
#                     needs one: download it from the service credentials and
#                     save it under src/config/ (gitignored, shipped in the image),
#                     e.g. ./src/config/my-cluster-ca.crt
