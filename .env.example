# GitHub Configuration
GITHUB_AI_AGENT_TOKEN=ghp_your_github_token_here
GITHUB_AI_AGENT_OWNER=carbon-design-system
GITHUB_AI_AGENT_REPO=carbon

# CLI Agent Configuration
GITHUB_AI_AGENT_CLI=bob

# Agent API Keys
#
# Bob authenticates by browser SSO on a laptop, which cannot complete in a
# container — BOB_API_KEY is the only viable path there. Create one with Scope
# set to "Inference" in the Bob web portal.
BOB_API_KEY=your_bob_api_key_here
#
# Only required when the API key is of type "general" rather than "Inference";
# leave blank otherwise, as sending it with an Inference key breaks the run.
BOB_TEAM_ID=

# Where review bundles are created. Leave blank on macOS: the default is
# /private/tmp, which Bob treats as trusted (os.tmpdir() resolves to
# /var/folders/... which is NOT, and Bob silently disables MCP tools there).
# The container sets this to /workspace.
BOB_WORKSPACE_ROOT=

# Optional Configuration
# Target a specific PR number instead of auto-selecting (leave blank for auto)
# GITHUB_AI_AGENT_PR_NUMBER=
GITHUB_AI_AGENT_MAX_PRS=1
GITHUB_AI_AGENT_DAYS_BACK=21
# Total input token budget for the agent (prompt overhead + diff).
# Derivation: 200k context − 40k MCP − 20k output = 140k input.
# Effective diff budget = (value − 12000 prompt overhead) × 4 chars/token = ~512k chars.
GITHUB_AI_AGENT_MAX_INPUT_TOKENS=140000
GITHUB_AI_AGENT_REVIEW_LABEL=AIReviewed
GITHUB_AI_AGENT_POST_INLINE_COMMENTS=true
GITHUB_AI_AGENT_POST_SUMMARY_COMMENT=true
GITHUB_AI_AGENT_KEEP_ARTIFACTS=false

# ── API server / operator console ─────────────────────────────────────────────
#
# Port. Code Engine injects PORT and it takes precedence over API_PORT.
API_PORT=3000

# Bearer token for machine callers (CI, curl). Not used by the console, which
# signs in and uses a session cookie instead.
API_SECRET=your_secure_api_secret_here
API_ENABLE_AUTH=true

# ── Console sign-in (feature flag, OFF by default) ────────────────────────────
#
# The default deployment requires NO authentication: the console loads straight
# to Operations, with no login page. Deliberately not tied to NODE_ENV — the
# posture is chosen, never inferred.
#
# Set to true to require a password-protected login. Accepts true/1/yes/on
# (and false/0/no/off); anything else is reported at startup and treated as off,
# so a typo cannot leave you believing the console is protected when it is not.
#
# With this ON, ES_USERNAME and ES_PASSWORD below become the sign-in credentials
# and must be set, and SESSION_SIGNING_KEY should be too.
# AUTH_REQUIRED=true

# HMAC key for session cookies. Only used when AUTH_REQUIRED is on. Without it
# the server falls back to a per-process random key, so every restart signs all
# operators out.
#   openssl rand -hex 32
SESSION_SIGNING_KEY=

# The console's public URL. In Code Engine this is folded into the revision by
# deploy_ce.sh; locally it is derived from the request. It is the OAuth
# redirect_uri, so "Sign in with IBMid" fails if it points at the wrong host.
# BASE_URL=

# ── Carbon MCP connection ─────────────────────────────────────────────────────
#
# Endpoint. Override only to point at a non-production Carbon MCP.
# CARBON_MCP_URL=https://mcp.carbondesignsystem.com/mcp
#
# Where the rotating OAuth refresh token is persisted. Put this on durable
# storage in the cloud, or a restart forces an operator back through sign-in.
# MCP_STATE_PATH=
#
# Renew this many seconds before the token expires (Carbon MCP's own margin is
# 300s; wider leaves room to retry a failed attempt).
# MCP_REFRESH_MARGIN_SEC=900
#
# How often the background timer re-checks expiry.
# MCP_REFRESH_CHECK_MS=60000

# Health-check budget for `bob --version`. Bob is a ~20MB bundle and is slow to
# start on a cold container — raise this if the status panel reports Bob as
# not responding when it is in fact fine.
# BOB_CHECK_TIMEOUT_MS=20000

# ── Bobcoins accounting ───────────────────────────────────────────────────────
#
# All three take a plain number. A value that is not a positive number is
# rejected with a warning at first use and the default is applied — so
# "10s" or "1e3x" degrades loudly rather than silently disabling the feature.
#
# How long a fetched balance stays fresh. The console polls from every open tab,
# so this is what stops a handful of tabs hammering the Bob gateway.
# BOB_CREDITS_TTL_MS=60000
#
# Hard ceiling on one gateway call, headers AND body. Bounds how long a hung
# billing host can delay a review.
# BOB_CREDITS_TIMEOUT_MS=10000
#
# Percentage of the monthly budget below which the Bobcoins tile warns.
# BOB_CREDITS_LOW_PCT=10

# Newest per-review cost records kept in the local ledger; older ones are
# dropped on write. The whole file is read and parsed on each ledger query, so
# raising this trades memory and CPU per request for more history.
# CREDIT_LEDGER_MAX=1000
#
# Where the ledger lives. Defaults beside MCP_STATE_PATH (/workspace in the
# container), the one directory the deployment already treats as writable.
# CREDIT_LEDGER_PATH=

# ── IBM Cloud deployment (deploy_ce.sh only) ─────────────────────────────
#
# Used ONLY by ./deploy_ce.sh, which sources this file. Not read by the app,
# and deliberately NOT copied into the Code Engine secret — it authenticates the
# deploy, and the running container has no use for a credential that can redeploy
# it.
#
# Create one with:
#   ibmcloud iam api-key-create carbon-monitor-deploy \
#     -d "Carbon Monitor CE deploy" --file /tmp/cm-key.json
# then copy the "apikey" value here and delete the file.
#IBMCLOUD_API_KEY=

# Deployment target. The defaults match carbon-mcp, so both services land in the
# same account, region, Code Engine project and registry namespace.
# REGION=us-south
# RESOURCE_GROUP="Carbon Experience Platform STAGING"
# PROJECT=mcp-ce
# NAMESPACE=cxp-mcp
# APP=carbon-monitor
# VERSION=1.0.0
#
# Name of the Code Engine secret. deploy_ce.sh creates or updates it from
# the credentials in THIS file on every deploy — there is no separate secret to
# maintain by hand.
# SECRET_NAME=carbon-monitor-secrets

# ── Metrics / Observability ───────────────────────────────────────────────────
#
# Elasticsearch — leave ES_URL blank to disable ES; console-only logging still
# works. Ask Ignacio for the ES_URL / credentials for the shared IBM cluster.
#
# NOTE: ES_USERNAME and ES_PASSWORD double as the operator console's sign-in
# credentials, matching Carbon Migrate's admin console so one identity works
# across both. That only applies when the AUTH_REQUIRED feature flag above is
# on — which it is NOT by default. With sign-in off these are Elasticsearch
# credentials and nothing more, and can be left blank when ES_URL is blank.
#
ES_URL=
ES_USERNAME=elastic
ES_PASSWORD=
ES_CA_CERT_PATH=
#
# How to get these values:
#   ES_URL      — IBM Elasticsearch cluster endpoint, e.g. https://cluster.es.ibm.com:9243
#   ES_USERNAME — usually "elastic" or a service-account username
#   ES_PASSWORD — from IBM Secrets Manager / the cluster admin (ask Ignacio)
#   ES_CA_CERT_PATH — path to PEM CA cert; only needed for self-signed certs
#                     (IBM Cloud clusters usually use public certs — leave blank)
