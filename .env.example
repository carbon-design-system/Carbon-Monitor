# GitHub Configuration
GITHUB_AI_AGENT_TOKEN=ghp_your_github_token_here
GITHUB_AI_AGENT_OWNER=carbon-design-system
GITHUB_AI_AGENT_REPO=carbon

# CLI Agent Configuration
GITHUB_AI_AGENT_CLI=bob

# Agent API Keys
BOBSHELL_API_KEY=your_bob_api_key_here

# Optional Configuration
GITHUB_AI_AGENT_MAX_PRS=1
GITHUB_AI_AGENT_DAYS_BACK=21
GITHUB_AI_AGENT_MAX_DIFF_CHARS=120000
GITHUB_AI_AGENT_REVIEW_LABEL=AIReviewed
GITHUB_AI_AGENT_POST_INLINE_COMMENTS=true
GITHUB_AI_AGENT_POST_SUMMARY_COMMENT=true
GITHUB_AI_AGENT_KEEP_ARTIFACTS=false

# API Server Configuration (only needed if running: npm run api)
API_PORT=3000
API_SECRET=your_secure_api_secret_here
API_ENABLE_AUTH=true

# ── Metrics / Observability (all optional) ────────────────────────────────────
#
# Elasticsearch — leave blank to disable ES; console-only logging still works.
# Ask Ignacio for the ES_URL / credentials for the shared IBM cluster.
#
ES_URL=
ES_USERNAME=elastic
ES_PASSWORD=
ES_CA_CERT_PATH=
#
# How to get these values:
#   ES_URL      — IBM Elasticsearch cluster endpoint, e.g. https://cluster.es.ibm.com:9243
#   ES_USERNAME — usually "elastic" or a service-account username
#   ES_PASSWORD — from IBM Secrets Manager / the cluster admin (ask Ignacio)
#   ES_CA_CERT_PATH — path to PEM CA cert; only needed for self-signed certs
#                     (IBM Cloud clusters usually use public certs — leave blank)
